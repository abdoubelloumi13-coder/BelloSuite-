{
  "name": "bellosuite",
  "description": "ERP system for Tunisian SMEs - Production v1.0.1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema ./prisma/schema && next build",
    "vercel-build": "prisma generate --schema ./prisma/schema && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "postinstall": "prisma generate --schema ./prisma/schema",
    "db:push": "prisma db push --schema ./prisma/schema",
    "db:migrate": "prisma migrate dev --schema ./prisma/schema",
    "db:studio": "prisma studio --schema ./prisma/schema",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-demo": "npx tsx prisma/seed-demo.ts",
    "i18n:check": "node scripts/check-i18n-keys.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "@types/nodemailer": "^7.0.11",
    "@xmldom/xmldom": "^0.8.15",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.14.2",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-seo": "^7.2.0",
    "nodemailer": "^10.0.16",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-crypto": "^6.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.19.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5"
  }
}
