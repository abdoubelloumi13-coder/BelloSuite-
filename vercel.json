{
  "version": 2,
  "regions": [
    "fra1"
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "github": {
    "autoJobCancelation": true,
    "autoAlias": true,
    "silent": true
  },
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/anomalies",
      "schedule": "0 5 * * *"
    }
  ]
}
