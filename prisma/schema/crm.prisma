// ============================================
// MODULE: CRM / PROSPECTION
// ============================================

enum LeadSource {
  WEBSITE
  LINKEDIN
  WHATSAPP
  EMAIL
  REFERRAL
  COLD_CALL
  EVENT
  OTHER
}

enum LeadStatus {
  NOUVEAU
  CONTACTE
  DEMO
  NEGOCIATION
  GAGNE
  PERDU
}

enum LeadSector {
  GARAGE
  PME_INDUSTRIE
  COMMERCE
  SERVICES
  AUTO_ENTREPRENEUR
  AUTRE
}

model Lead {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  code            String       // ex: LEAD-001
  name            String       // Nom du contact
  company         String?      // Nom de l'entreprise
  email           String?
  phone           String?
  address         String?
  city            String?
  zipCode         String?
  sector          LeadSector   @default(AUTRE)
  source          LeadSource   @default(OTHER)
  status          LeadStatus   @default(NOUVEAU)
  estimatedValue  Decimal?     // Valeur estimée du deal (DT)
  nextFollowUp    DateTime?    // Prochaine relance planifiée
  notes           String?
  lostReason      String?      // Raison si PERDU
  convertedToClientId String?  // Lien vers Client si GAGNE
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  leadNotes       LeadNote[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, city])
  @@index([tenantId, sector])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  content   String
  author    String?  // Nom de l'utilisateur qui a ajouté la note
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}