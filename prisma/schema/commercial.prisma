// ============================================
// MODULE: COMMERCIAL
// ============================================

model Client {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  email           String?
  phone           String?
  address         String?
  city            String?
  zipCode         String?
  country         String   @default("Tunisie")
  matriculeFiscal String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
}

model Supplier {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String   @default("Tunisie")
  matriculeFiscal String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  supplierReturns SupplierReturn[]

  @@unique([tenantId, code])
}

model Invoice {
  id       String        @id @default(uuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  clientId String
  client   Client        @relation(fields: [clientId], references: [id])
  number   String
  type     String        @default("INVOICE")
  status   InvoiceStatus @default(DRAFT)
  date     DateTime      @default(now())
  dueDate  DateTime?

  subtotalHT   Decimal @default(0)
  totalFodec   Decimal @default(0)
  totalVAT     Decimal @default(0)
  timbreFiscal Decimal @default(1.000)
  totalTTC     Decimal @default(0)
  vatSummary   Json?

  currency        String    @default("TND")
  exchangeRate    Decimal   @default(1)
  originalAmount  Decimal?
  rsAmount        Decimal   @default(0)
  irppAmount      Decimal   @default(0)
  totalInCurrency Decimal?
  /// Document source d'une conversion (devis → BC/facture, BC → BL/facture, BL → facture)
  convertedFromId String?
  convertedAt     DateTime?
  /// Avoir : facture d'origine annulée / réduite
  originalInvoiceId String?
  /// Montant soldé sur le compte client 411 (encaissements + RS subie), pour les règlements partiels
  amountSettled     Decimal   @default(0)
  /// Lignes à 0 % : EXEMPT (art. 4 CTVA) | SUSPENSION (art. 11) | EXPORT — et mention légale imprimée
  vatExemption      String?
  vatMention        String?

  // Bon de livraison : dépôt de sortie du stock (null = documents antérieurs / non concernés)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  notes             String?
  accountingEntryId String?
  paymentEntryId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ─── TTN / El Fatoora E-Invoicing ───────────────────────
  ttnStatus       String    @default("DRAFT")
  ttnReference    String?
  ttnQRCode       String?
  ttnSubmittedAt  DateTime?
  ttnAcceptedAt   DateTime?
  ttnErrorCode    String?
  ttnErrorMessage String?
  ttnPDFUrl       String?
  ttnXMLSignedUrl String?
  aspProvider     String?
  aspReference    String?

  // ─── Relances / Suivi Paiement ──────────────────────────
  lastReminderSentAt DateTime?
  reminders          PaymentReminder[]

  // ─── Pipeline Commercial ────────────────────────────────
  exportInvoice    ExportInvoice?
  withholdingTaxes WithholdingTax[]
  items            InvoiceItem[]
  paymentFollowUp  PaymentFollowUp?

  /// Numérotation légale : un numéro par tenant + type (séquence DocumentSequence)
  @@unique([tenantId, type, number])
  @@index([tenantId, convertedFromId])
  @@index([tenantId, originalInvoiceId])
}

/// Séquence de numérotation légale par tenant, série (FAC, DEV, BC, BL, AV…) et exercice.
/// Incrémentée atomiquement dans la transaction de création (lib/document-numbering).
model DocumentSequence {
  id        String   @id @default(uuid())
  tenantId  String
  /// Préfixe de série : FAC | DEV | BC | BL | AV | NH
  type      String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, type, year])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  SUBMITTED
  CONFIRMED
  SENT
  ACCEPTED
  PAID
  REJECTED
  CANCELLED
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  unit        String  @default("EA")
  quantity    Decimal
  unitPriceHT Decimal
  discount    Decimal @default(0)
  fodecApply  Boolean @default(false)
  fodecAmount Decimal @default(0)
  vatRate     Decimal @default(19)
  vatAmount   Decimal @default(0)
  totalHT     Decimal @default(0)
  totalTTC    Decimal @default(0)
}

model PurchaseOrder {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  clientId          String?
  client            Client?         @relation(fields: [clientId], references: [id])
  supplierId        String?
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])
  number            String
  type              String
  status            String          @default("DRAFT")
  date              DateTime        @default(now())
  expectedDate      DateTime?
  subtotal          Decimal         @default(0)
  taxRate           Decimal         @default(0)
  taxAmount         Decimal         @default(0)
  total             Decimal         @default(0)
  notes             String?
  accountingEntryId String?
  /// Dépôt de livraison prévu (bon de commande)
  warehouseId       String?
  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id])
  /// Facture fournisseur → bon de commande lié
  linkedOrderId     String?
  linkedOrder       PurchaseOrder?  @relation("PurchaseInvoiceOrder", fields: [linkedOrderId], references: [id])
  linkedInvoices    PurchaseOrder[] @relation("PurchaseInvoiceOrder")
  supplierRef       String?
  confirmedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@unique([tenantId, number])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  description     String
  quantity        Decimal
  unitPrice       Decimal
  total           Decimal

  receiptItems GoodsReceiptItem[]
}

/// Bon de réception fournisseur : SEUL document d'achat qui fait entrer du stock (ENTRY / PURCHASE).
model GoodsReceipt {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  number          String
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  /// DRAFT | VALIDATED | CANCELLED
  status          String         @default("DRAFT")
  date            DateTime       @default(now())
  supplierRef     String?
  notes           String?
  total           Decimal        @default(0)
  validatedAt     DateTime?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  items   GoodsReceiptItem[]
  returns SupplierReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id                  String             @id @default(uuid())
  receiptId           String
  receipt             GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  description         String?
  quantity            Decimal
  unitCost            Decimal            @default(0)

  returnItems SupplierReturnItem[]

  @@index([receiptId])
  @@index([purchaseOrderItemId])
}

/// Retour fournisseur depuis un bon de réception (EXIT / SUPPLIER_RETURN).
model SupplierReturn {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  number      String
  receiptId   String
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id])
  supplierId  String?
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  status      String       @default("VALIDATED")
  date        DateTime     @default(now())
  notes       String?
  total       Decimal      @default(0)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  items SupplierReturnItem[]

  @@unique([tenantId, number])
  @@index([receiptId])
}

model SupplierReturnItem {
  id             String           @id @default(uuid())
  returnId       String
  supplierReturn SupplierReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  receiptItemId  String
  receiptItem    GoodsReceiptItem @relation(fields: [receiptItemId], references: [id])
  productId      String
  product        Product          @relation(fields: [productId], references: [id])
  quantity       Decimal
  unitCost       Decimal          @default(0)

  @@index([returnId])
  @@index([receiptItemId])
}

// ============================================
// MODULE: POS
// ============================================

model CashDrawer {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  balance   Decimal  @default(0)
  updatedAt DateTime @updatedAt
}

model POSSession {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  userId      String
  userName    String
  openingCash Decimal
  closingCash Decimal?
  status      POSSessionStatus @default(OPEN)
  openedAt    DateTime         @default(now())
  closedAt    DateTime?
  notes       String?

  orders POSOrder[]
}

enum POSSessionStatus {
  OPEN
  CLOSED
}

model POSOrder {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  sessionId       String
  session         POSSession     @relation(fields: [sessionId], references: [id])
  orderNumber     String
  type            POSType        @default(SALE)
  status          POSOrderStatus @default(CONFIRMED)
  clientId        String?
  clientName      String?
  subtotalHT      Decimal        @default(0)
  totalVAT        Decimal        @default(0)
  timbreFiscal    Decimal        @default(1)
  totalTTC        Decimal        @default(0)
  paidAmount      Decimal        @default(0)
  changeGiven     Decimal        @default(0)
  paymentMethod   PaymentMethod  @default(CASH)
  isPaid          Boolean        @default(false)
  discountPercent Decimal        @default(0)
  discountAmount  Decimal        @default(0)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items    POSOrderItem[]
  payments POSPayment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, sessionId])
}

enum POSType {
  SALE
  RETURN
}

enum POSOrderStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  CHECK
  BANK_TRANSFER
  MIXED
}

model POSOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       POSOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productCode String?
  description String
  quantity    Decimal
  unitPriceHT Decimal
  vatRate     Decimal  @default(19)
  vatAmount   Decimal  @default(0)
  discount    Decimal  @default(0)
  totalHT     Decimal  @default(0)
  totalTTC    Decimal  @default(0)
}

model POSPayment {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  orderId   String
  order     POSOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
}

// ============================================
// MODULE: COMMERCIAL — RELANCES PAIEMENT
// ============================================

model PaymentFollowUp {
  id               String              @id @default(uuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  invoiceId        String              @unique
  invoice          Invoice             @relation(fields: [invoiceId], references: [id])
  status           PaymentFollowStatus @default(PENDING)
  nextReminderDate DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  reminders PaymentReminder[]
}

enum PaymentFollowStatus {
  PENDING
  REMINDED
  PARTIAL
  PAID
  DISPUTED
  CANCELLED
}

model PaymentReminder {
  id           String           @id @default(uuid())
  invoiceId    String
  invoice      Invoice          @relation(fields: [invoiceId], references: [id])
  followUpId   String?
  followUp     PaymentFollowUp? @relation(fields: [followUpId], references: [id])
  method       ReminderMethod
  response     String?
  errorMessage String?
  sentAt       DateTime         @default(now())
}

enum ReminderMethod {
  EMAIL
  SMS
  WHATSAPP
}

// ============================================
// MODULE: ASP CONFIGURATION (TTN)
// ============================================

model ASPConfiguration {
  id            String            @id @default(uuid())
  tenantId      String            @unique
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  provider      String
  apiKey        String
  apiSecret     String
  mode          TTNSubmissionMode @default(EDI)
  sftpUsername  String?
  sftpPassword  String?
  sftpEndpoint  String?
  isActive      Boolean           @default(false)
  webhookSecret String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// ============================================
// MODULE: DEVISES & TAUX DE CHANGE
// ============================================

model ExchangeRate {
  id        String    @id @default(uuid())
  tenantId  String    @unique
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency  String
  rateToTND Decimal
  source    String?
  fetchedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, currency])
}

// ============================================
// MODULE: EXPORT & DOCUMENTS INTERNATIONAUX
// ============================================

model ExportInvoice {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId     String   @unique
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  countryDest   String
  incoterm      String
  hsCode        String?
  netWeightKg   Decimal?
  countryOrigin String   @default("TN")
  exportRegime  String?
  customsPort   String?
  transportMode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// MODULE: TEJ 2026 — RETENUE À LA SOURCE
// ============================================

model WithholdingTax {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  /// DECLARED : retenue opérée par le tenant sur un paiement (achats) → déclarée au TEJ.
  /// SUFFERED : retenue subie, opérée par le client sur une facture de vente → créance sur l'État,
  ///            certificat attendu du client ; jamais exportée au TEJ par le tenant.
  direction             String    @default("DECLARED")
  /// Achat (facture / BC fournisseur) à l'origine d'une RS déclarée
  purchaseOrderId       String?
  /// RS subie : date de réception du certificat de retenue remis par le client
  certificateReceivedAt DateTime?

  beneficiaryTin     String?
  beneficiaryName    String
  beneficiaryAddress String?
  beneficiaryType    BeneficiaryType @default(INDIVIDU)
  /// Régime fiscal du bénéficiaire (IS_20 | IS_10 | STANDARD | FORFAIT | HOTEL) — fixe le taux RS
  beneficiaryRegime  String?
  beneficiaryEmail   String?
  beneficiaryPhone   String?

  serviceType        ServiceType @default(PRESTATION_SERVICE)
  serviceDescription String?

  /// Montant TTC payé (base de la retenue)
  grossAmount Decimal @default(0)
  /// Taux de TVA de l'opération (%), pour la ventilation HT/TVA du fichier TEJ
  vatRate     Decimal?
  rate        Decimal @default(0)
  taxAmount   Decimal @default(0)
  netAmount   Decimal @default(0)
  teeJAmount  Decimal @default(0)

  periodMonth Int
  periodYear  Int

  tejId           String?
  tejXmlId        String?
  tejReference    String?
  tejStatus       TEJStatus @default(DRAFT)
  exportedAt      DateTime?
  submittedAt     DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  paymentDate      DateTime?
  paymentMethod    PaymentMethodType?
  paymentReference String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, tejId])
  @@index([tenantId, periodYear, periodMonth])
  @@index([tenantId, tejStatus])
  @@index([tenantId, beneficiaryTin])
  @@index([tenantId, direction])
}

enum BeneficiaryType {
  INDIVIDU
  SOCIETE
}

enum ServiceType {
  PRESTATION_SERVICE
  HONORAIRES
  LOYERS
  DIVIDENDES
  INTERETS
  ROYALTIES
  REMUNERATION
  AUTRE
}

enum TEJStatus {
  DRAFT
  EXPORTED
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PaymentMethodType {
  VIREMENT
  CHEQUE
  ESPECE
}
