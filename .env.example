# Copier en .env.local (jamais commité) et remplir.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Connexion Prisma (rôle postgres) — mot de passe à faire tourner, jamais dans Git
DATABASE_URL=
DIRECT_URL=
# Obligatoire, >= 32 caractères : openssl rand -base64 48
SESSION_SECRET=
# Obligatoire pour /api/cron/* (en-tête Authorization: Bearer <CRON_SECRET>) : openssl rand -hex 32
CRON_SECRET=
RESEND_API_KEY=
# Obligatoire pour enregistrer/lire les identifiants ASP/TTN chiffrés (32 octets en base64) :
#   openssl rand -base64 32
#   PowerShell : [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }) -as [byte[]])
ASP_ENCRYPTION_KEY=
# Email matinal « points à vérifier » (src/lib/mailer.ts) — gratuit, au choix :
#  a) Gmail SMTP : mot de passe d'application (compte Google → Sécurité → Mots de passe des applications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#  b) Resend (offre gratuite) : RESEND_API_KEY ci-dessus + expéditeur d'un domaine vérifié
RESEND_FROM=
# Optionnel : forcer smtp | resend | none ; expéditeur affiché ; URL des liens dans les emails
MAIL_PROVIDER=
MAIL_FROM=
NEXT_PUBLIC_APP_URL=https://bellosuite.vercel.app
