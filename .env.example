# Copier en .env.local (jamais commité) et remplir.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Connexion Prisma (rôle postgres) — mot de passe à faire tourner, jamais dans Git
DATABASE_URL=
DIRECT_URL=
# Obligatoire, >= 32 caractères : openssl rand -base64 48
SESSION_SECRET=
# Obligatoire pour /api/cron/* (en-tête Authorization: Bearer <CRON_SECRET>) : openssl rand -hex 32
CRON_SECRET=
RESEND_API_KEY=
# Obligatoire pour enregistrer/lire les identifiants ASP/TTN chiffrés (32 octets en base64) :
#   openssl rand -base64 32
#   PowerShell : [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }) -as [byte[]])
ASP_ENCRYPTION_KEY=
# Email matinal « points à vérifier » (src/lib/mailer.ts) — gratuit, au choix :
#  a) Gmail SMTP : mot de passe d'application (compte Google → Sécurité → Mots de passe des applications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#  b) Resend (offre gratuite) : RESEND_API_KEY ci-dessus + expéditeur d'un domaine vérifié
RESEND_FROM=
# Optionnel : forcer smtp | resend | none ; expéditeur affiché ; URL des liens dans les emails
MAIL_PROVIDER=
MAIL_FROM=
NEXT_PUBLIC_APP_URL=https://bellosuite.vercel.app

# ── E-mails de confirmation Supabase (scripts/configure-supabase-emails.ts uniquement)
# SUPABASE_ACCESS_TOKEN=
# PROJECT_REF=

# ── Contact commercial affiché sur la page d'accueil (défaut : adresse du fondateur)
NEXT_PUBLIC_SALES_EMAIL=

# ── IA (optionnel ; sans clé, l'extraction / dictée restent déterministes)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=
GROQ_API_KEY=
# GROQ_MODEL=
PARSEFLOW_API_KEY=
# PARSEFLOW_MODEL=parseflow-default

# ── Facture électronique / TTN
# Secret HMAC du QR code en mode simulation (openssl rand -hex 32) ; défaut interne si vide (à éviter en prod)
EINVOICE_SIM_HMAC_SECRET=
# Dépôt TTN réel via prestataire ASP : laisser vide / false tant que le prestataire n'est pas vérifié
TTN_ASP_VERIFIED=false

# ── Relances clients (src/lib/reminder-service.ts) — tous optionnels
# E-mail via Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# SMS via Africa's Talking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
# WhatsApp via ChatAPI…
CHATAPI_INSTANCE_ID=
CHATAPI_TOKEN=
# …ou via Chatwoot
CHATWOOT_URL=https://app.chatwoot.com
CHATWOOT_WHATSAPP_TOKEN=
CHATWOOT_INBOX_ID=
